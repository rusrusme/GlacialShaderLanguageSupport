<idea-plugin>
    <id>net.rusrusme.bsh</id>
    <name>Basis Shader Language</name>
    <vendor>rusrusme</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Basis Shader File"
                implementationClass="net.rusrusme.bsh.core.BshFileType"
                fieldName="INSTANCE"
                language="BasisShader"
                extensions="bsh"/>

        <lang.parserDefinition
                language="BasisShader"
                implementationClass="net.rusrusme.bsh.core.BshParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="BasisShader"
                implementationClass="net.rusrusme.bsh.highlight.BshSyntaxHighlighterFactory"/>

        <lang.commenter
                language="BasisShader"
                implementationClass="net.rusrusme.bsh.core.BshCommenter"/>

        <annotator
                language="BasisShader"
                implementationClass="net.rusrusme.bsh.annotator.BshAnnotator"/>

        <lang.braceMatcher
                language="BasisShader"
                implementationClass="net.rusrusme.bsh.core.BshBraceMatcher"/>

        <lang.formatter
                language="BasisShader"
                implementationClass="net.rusrusme.bsh.formatting.BshFormattingModelBuilder"/>

        <langCodeStyleSettingsProvider
                implementation="net.rusrusme.bsh.formatting.BshLanguageCodeStyleSettingsProvider"/>

        <completion.contributor
                language="BasisShader"
                implementationClass="net.rusrusme.bsh.core.BshCompletionContributor"/>

        <psi.referenceContributor
                language="BasisShader"
                implementation="net.rusrusme.bsh.psi.BshReferenceContributor"/>

        <internalFileTemplate name="Basis Shader File"/>
    </extensions>

    <actions>
        <action id="Bsh.NewFile"
                class="net.rusrusme.bsh.action.BshCreateFileAction"
                text="Basis Shader File"
                description="Create a new Basis Shader file">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>