<idea-plugin>
    <id>net.rusrusme.gshader</id>
    <name>Glacial Shader Language</name>
    <vendor url="https://github.com/rusrusme/GlacialShaderLanguageSupport"
            email="ruslanmelikov.me@gmail.com">rusrusme
    </vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="Glacial Shader File"
                implementationClass="net.rusrusme.gshader.core.GFileType"
                fieldName="INSTANCE"
                language="GlacialShader"
                extensions="gshader"/>

        <lang.parserDefinition
                language="GlacialShader"
                implementationClass="net.rusrusme.gshader.core.GParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="GlacialShader"
                implementationClass="net.rusrusme.gshader.highlight.GSyntaxHighlighterFactory"/>

        <lang.commenter
                language="GlacialShader"
                implementationClass="net.rusrusme.gshader.core.GCommenter"/>

        <annotator
                language="GlacialShader"
                implementationClass="net.rusrusme.gshader.annotator.GAnnotator"/>

        <lang.braceMatcher
                language="GlacialShader"
                implementationClass="net.rusrusme.gshader.core.GBraceMatcher"/>

        <lang.formatter
                language="GlacialShader"
                implementationClass="net.rusrusme.gshader.formatting.GFormattingModelBuilder"/>

        <langCodeStyleSettingsProvider
                implementation="net.rusrusme.gshader.formatting.GLanguageCodeStyleSettingsProvider"/>

        <completion.contributor
                language="GlacialShader"
                implementationClass="net.rusrusme.gshader.core.GCompletionContributor"/>

        <psi.referenceContributor
                language="GlacialShader"
                implementation="net.rusrusme.gshader.psi.GReferenceContributor"/>

        <internalFileTemplate name="Glacial Shader File"/>
    </extensions>

    <actions>
        <action id="GShader.NewFile"
                class="net.rusrusme.gshader.action.GCreateFileAction"
                text="Glacial Shader File"
                description="Create a new Glacial Shader file">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
    </actions>
</idea-plugin>